# Local development (the root `npm run dev` also sets these defaults).
AUTH_MODE=local
ALLOW_LOCAL_GUEST=true
GAME_HOST=127.0.0.1
GAME_PORT=2567
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# LOCAL_DATA_DIR=C:/dev/game/.local-data

# Self-hosted Linux production: deploy/setup.sh creates .env.self-host for Compose.
# AUTH_MODE=guest
# GAME_HOST=0.0.0.0
# WEB_ORIGIN=https://game.minseok91.cloud
# TRUST_PROXY=1
# GUEST_SIGNING_SECRET=<64 hexadecimal characters from 32 random bytes>
# GUEST_TOKEN_TTL_SECONDS=604800
# DATABASE_URL=postgresql://ringuringu:<password>@postgres:5432/ringuringu
# DATABASE_SSL_MODE=disable
# DATABASE_ALLOW_PRIVATE_NETWORK=true
# DATABASE_POOL_SIZE=10
# NEXT_PUBLIC_GAME_SERVER_URL=https://game.minseok91.cloud

# A remote PostgreSQL provider must use verified TLS. Never put sslmode or
# host/port overrides in DATABASE_URL query parameters.
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=<optional PEM certificate>

# The older optional Supabase adapter is retained, but is not used by Compose.
# AUTH_MODE=supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# DATABASE_URL=
